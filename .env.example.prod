# Copy to .env, restrict its permissions, and replace every placeholder.
APP_NAME=SocialMesh
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_GENERATED_32_BYTE_KEY
APP_URL=https://socialmesh.slotforge.qd.je

# App is only reachable through the Caddy service in docker-compose.production.yaml.
OCTANE_HTTPS=true
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

# Single-container SQLite + database-backed cache, queue, and sessions.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/sqlite/database.sqlite
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
QUEUE_WORKER_ENABLED=true
QUEUE_WORKER_COUNT=1
SCHEDULER_ENABLED=true
INERTIA_SSR_ENABLED=false
DIRECT_MESSAGES_ENABLED=false

# Cloudflare R2 / S3-compatible media. The bucket's public media URL must be
# reachable over HTTPS by Meta; use your production R2 custom domain or public URL.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=REPLACE_WITH_R2_BUCKET_NAME
AWS_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=https://REPLACE_WITH_PUBLIC_R2_DOMAIN
AWS_USE_PATH_STYLE_ENDPOINT=true

# Existing Meta app for Facebook and Instagram.
FACEBOOK_CLIENT_ID=REPLACE_WITH_META_APP_ID
FACEBOOK_CLIENT_SECRET=REPLACE_WITH_META_APP_SECRET
FACEBOOK_REDIRECT_URI=https://socialmesh.slotforge.qd.je/accounts/callback/meta
FACEBOOK_GRAPH_VERSION=v25.0

# Threads app credentials. It may be the same Meta app only if configured that way.
THREADS_CLIENT_ID=REPLACE_WITH_THREADS_APP_ID
THREADS_CLIENT_SECRET=REPLACE_WITH_THREADS_APP_SECRET
THREADS_REDIRECT_URI=https://socialmesh.slotforge.qd.je/accounts/callback/threads

# Keep optional Socialite login disabled until separately configured.
SOCIALITE_ENABLED=false
