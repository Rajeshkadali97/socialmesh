# Copy to .env, restrict its permissions, and replace every placeholder.
# Works for both the VPS stack (docker-compose.production.yaml) and the
# single-machine Cloudflare Tunnel stack (+ docker-compose.tunnel.yaml).
APP_NAME=SocialMesh
APP_ENV=production
APP_DEBUG=false
# Generate once and keep it: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
# Changing it later invalidates sessions and stored encrypted tokens (connected accounts).
APP_KEY=base64:REPLACE_WITH_GENERATED_32_BYTE_KEY
APP_URL=https://REPLACE_WITH_PUBLIC_HOSTNAME

# TLS ends at nginx (VPS) or Cloudflare (tunnel); the app sees proxied HTTPS.
OCTANE_HTTPS=true
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

# Single-container SQLite + database-backed cache, queue, and sessions.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/sqlite/database.sqlite
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
QUEUE_WORKER_ENABLED=true
QUEUE_WORKER_COUNT=1
QUEUE_WORKER_MEMORY_MB=256
SCHEDULER_ENABLED=true
INERTIA_SSR_ENABLED=false
DIRECT_MESSAGES_ENABLED=false

# Mail is written to storage/logs until a real mailer is configured. Workspace
# invitations still work: the owner copies the join link from the Members page.
MAIL_MAILER=log

# Only the first account (the instance owner) can register while this is false;
# later users join through a workspace invitation link.
INSTANCE_REGISTRATIONS_ENABLED=false

# Cloudflare Tunnel (docker-compose.tunnel.yaml). Paste the token from
# Zero Trust > Networks > Tunnels. Never commit it.
TUNNEL_TOKEN=

# Media storage. `public` keeps files on the storage volume and serves them at
# ${APP_URL}/storage so Meta can fetch them. For the VPS/R2 setup set
# FILESYSTEM_DISK=s3 and fill the AWS_* values below.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Meta app (Facebook and Instagram). Callback must match the app's allowlist.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/accounts/callback/meta
FACEBOOK_GRAPH_VERSION=v25.0

# Threads app credentials. It may be the same Meta app only if configured that way.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=${APP_URL}/accounts/callback/threads

# Keep optional Socialite login disabled until separately configured.
SOCIALITE_ENABLED=false
